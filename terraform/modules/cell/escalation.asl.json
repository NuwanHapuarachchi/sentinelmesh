{
  "Comment": "SentinelMesh escalation for cell ${cell}: de-duplicate, approve warnings (timeout issues anyway), issue, enqueue by tier, notify officers. All-clears need an officer (timeout sends nothing).",
  "StartAt": "RankTier",
  "States": {
    "RankTier": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.tier", "StringEquals": "clear", "Next": "RequestClearApproval" },
        { "Variable": "$.tier", "StringEquals": "imminent", "Next": "RankImminent" },
        { "Variable": "$.tier", "StringEquals": "warning", "Next": "RankWarning" }
      ],
      "Default": "RankAdvisory"
    },
    "RequestClearApproval": {
      "Comment": "An all-clear needs an officer. Fail toward staying alerted: a timeout or any failure here sends nothing and the earlier alert stays in force.",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${approvals_fn_arn}",
        "Payload": {
          "op": "approval_request",
          "token.$": "$$.Task.Token",
          "approval_id.$": "$$.Execution.Name",
          "input.$": "$"
        }
      },
      "TimeoutSecondsPath": "$.approval_timeout_s",
      "ResultPath": "$.approval",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.approval_error", "Next": "MarkClearUnconfirmed" }],
      "Next": "ClearDecision"
    },
    "ClearDecision": {
      "Type": "Choice",
      "Choices": [{ "Variable": "$.approval.decision", "StringEquals": "reject", "Next": "RecordClearHeld" }],
      "Default": "ClearStillValid"
    },
    "ClearStillValid": {
      "Comment": "Send the all-clear only if the zone is still calm: below advisory and no new alert in progress.",
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${zone_state_table}",
        "Key": { "zone_id": { "S.$": "$.zone_id" } },
        "UpdateExpression": "SET clear_confirmed_at = :t",
        "ConditionExpression": "attribute_not_exists(alert_rank) AND (attribute_not_exists(tier) OR tier IN (:normal, :watch))",
        "ExpressionAttributeValues": {
          ":t": { "S.$": "$$.State.EnteredTime" },
          ":normal": { "S": "normal" },
          ":watch": { "S": "watch" }
        }
      },
      "ResultPath": null,
      "Catch": [
        { "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "ResultPath": null, "Next": "RecordSuperseded" },
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.check_error", "Next": "MarkClearUnconfirmed" }
      ],
      "Next": "Issue"
    },
    "RecordClearHeld": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${issuer_fn_arn}",
        "Payload": {
          "op": "record",
          "mode": "rejected",
          "execution.$": "$$.Execution.Name",
          "entered.$": "$$.State.EnteredTime",
          "input.$": "$",
          "approval.$": "$.approval"
        }
      },
      "ResultPath": null,
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2, "MaxAttempts": 3 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "Done" }],
      "Next": "Done"
    },
    "MarkClearUnconfirmed": {
      "Type": "Pass",
      "Parameters": { "decision": "timeout", "approval_id.$": "$$.Execution.Name" },
      "ResultPath": "$.approval",
      "Next": "RecordClearUnconfirmed"
    },
    "RecordClearUnconfirmed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${issuer_fn_arn}",
        "Payload": {
          "op": "record",
          "mode": "unconfirmed",
          "execution.$": "$$.Execution.Name",
          "entered.$": "$$.State.EnteredTime",
          "input.$": "$",
          "approval.$": "$.approval"
        }
      },
      "ResultPath": null,
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2, "MaxAttempts": 3 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "IsTestClear" }],
      "Next": "IsTestClear"
    },
    "IsTestClear": {
      "Type": "Choice",
      "Choices": [{ "Variable": "$.is_test", "BooleanEquals": true, "Next": "Done" }],
      "Default": "NotifyClearUnconfirmed"
    },
    "NotifyClearUnconfirmed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${officers_topic_arn}",
        "Subject": "SentinelMesh: all-clear NOT sent - alert still in force",
        "Message.$": "States.Format('Nobody confirmed the all-clear for zone {} in time, so none was sent and the earlier alert stays in force. Issue an all-clear manually when it is safe.', $.zone_id)"
      },
      "ResultPath": null,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "Done" }],
      "Next": "Done"
    },
    "RankImminent": { "Type": "Pass", "Result": "4", "ResultPath": "$.rank", "Next": "Gate" },
    "RankWarning": { "Type": "Pass", "Result": "3", "ResultPath": "$.rank", "Next": "Gate" },
    "RankAdvisory": { "Type": "Pass", "Result": "2", "ResultPath": "$.rank", "Next": "Gate" },
    "Gate": {
      "Comment": "One alert per zone per tier per episode, whether it came from the scorer or the IoT bypass.",
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${zone_state_table}",
        "Key": { "zone_id": { "S.$": "$.zone_id" } },
        "UpdateExpression": "SET alert_rank = :r, alert_tier = :t, alert_exec = :e REMOVE alert_confirmed_at",
        "ConditionExpression": "attribute_not_exists(alert_rank) OR alert_rank < :r",
        "ExpressionAttributeValues": {
          ":r": { "N.$": "$.rank" },
          ":t": { "S.$": "$.tier" },
          ":e": { "S.$": "$$.Execution.Name" }
        }
      },
      "ResultPath": null,
      "Catch": [
        { "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "ResultPath": null, "Next": "Deduplicated" }
      ],
      "Next": "RouteTier"
    },
    "Deduplicated": { "Type": "Succeed" },
    "RouteTier": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            { "Variable": "$.tier", "StringEquals": "warning" },
            { "Variable": "$.approval_timeout_s", "IsPresent": true }
          ],
          "Next": "RequestApproval"
        }
      ],
      "Default": "NoApproval"
    },
    "NoApproval": {
      "Type": "Pass",
      "Result": { "decision": "auto" },
      "ResultPath": "$.approval",
      "Next": "Issue"
    },
    "RequestApproval": {
      "Comment": "Waits for a duty officer. A timeout or any failure here still issues the alert.",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${approvals_fn_arn}",
        "Payload": {
          "op": "approval_request",
          "token.$": "$$.Task.Token",
          "approval_id.$": "$$.Execution.Name",
          "input.$": "$"
        }
      },
      "TimeoutSecondsPath": "$.approval_timeout_s",
      "ResultPath": "$.approval",
      "Catch": [
        { "ErrorEquals": ["States.Timeout"], "ResultPath": "$.approval_error", "Next": "MarkTimeout" },
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.approval_error", "Next": "MarkTimeout" }
      ],
      "Next": "Decision"
    },
    "MarkTimeout": {
      "Type": "Pass",
      "Parameters": { "decision": "timeout", "approval_id.$": "$$.Execution.Name" },
      "ResultPath": "$.approval",
      "Next": "StillCurrent"
    },
    "Decision": {
      "Type": "Choice",
      "Choices": [{ "Variable": "$.approval.decision", "StringEquals": "reject", "Next": "RecordReject" }],
      "Default": "StillCurrent"
    },
    "StillCurrent": {
      "Comment": "After waiting for an officer, issue only if this execution still owns the zone's alert gate. A higher tier issued meanwhile, or the zone falling below advisory, supersedes this warning. Any other failure of the check issues anyway (fail toward alerting).",
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${zone_state_table}",
        "Key": { "zone_id": { "S.$": "$.zone_id" } },
        "UpdateExpression": "SET alert_confirmed_at = :t",
        "ConditionExpression": "alert_exec = :e",
        "ExpressionAttributeValues": {
          ":e": { "S.$": "$$.Execution.Name" },
          ":t": { "S.$": "$$.State.EnteredTime" }
        }
      },
      "ResultPath": null,
      "Catch": [
        { "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"], "ResultPath": null, "Next": "RecordSuperseded" },
        { "ErrorEquals": ["States.ALL"], "ResultPath": "$.check_error", "Next": "Issue" }
      ],
      "Next": "Issue"
    },
    "RecordSuperseded": {
      "Comment": "The newer alert owns the gate, so it is not released here.",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${issuer_fn_arn}",
        "Payload": {
          "op": "record",
          "mode": "superseded",
          "execution.$": "$$.Execution.Name",
          "entered.$": "$$.State.EnteredTime",
          "input.$": "$",
          "approval.$": "$.approval"
        }
      },
      "ResultPath": null,
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2, "MaxAttempts": 3 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "Superseded" }],
      "Next": "Superseded"
    },
    "Superseded": { "Type": "Succeed" },
    "RecordReject": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${issuer_fn_arn}",
        "Payload": {
          "op": "record",
          "mode": "rejected",
          "execution.$": "$$.Execution.Name",
          "entered.$": "$$.State.EnteredTime",
          "input.$": "$",
          "approval.$": "$.approval"
        }
      },
      "ResultPath": null,
      "Next": "ReleaseGate"
    },
    "ReleaseGate": {
      "Comment": "A rejected warning frees the gate so later evidence can raise it again.",
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${zone_state_table}",
        "Key": { "zone_id": { "S.$": "$.zone_id" } },
        "UpdateExpression": "REMOVE alert_rank, alert_tier, alert_exec, alert_confirmed_at"
      },
      "ResultPath": null,
      "End": true
    },
    "Issue": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${issuer_fn_arn}",
        "Payload": {
          "op": "issue",
          "execution.$": "$$.Execution.Name",
          "entered.$": "$$.State.EnteredTime",
          "input.$": "$",
          "approval.$": "$.approval"
        }
      },
      "ResultSelector": {
        "alert_id.$": "$.Payload.alert_id",
        "queue_url.$": "$.Payload.queue_url",
        "message.$": "$.Payload.message",
        "summary.$": "$.Payload.summary",
        "is_test.$": "$.Payload.is_test"
      },
      "ResultPath": "$.issue",
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 1,
          "BackoffRate": 2,
          "MaxAttempts": 4
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.issue_error", "Next": "IssueFailed" }],
      "Next": "Enqueue"
    },
    "Enqueue": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Parameters": {
        "QueueUrl.$": "$.issue.queue_url",
        "MessageBody.$": "$.issue.message"
      },
      "ResultPath": null,
      "Retry": [{ "ErrorEquals": ["States.ALL"], "IntervalSeconds": 1, "BackoffRate": 2, "MaxAttempts": 4 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.enqueue_error", "Next": "EnqueueFailed" }],
      "Next": "IsTestAlert"
    },
    "IsTestAlert": {
      "Comment": "Heartbeat and e2e alerts (test zones) never email officers.",
      "Type": "Choice",
      "Choices": [{ "Variable": "$.issue.is_test", "BooleanEquals": true, "Next": "Done" }],
      "Default": "NotifyOfficers"
    },
    "NotifyOfficers": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${officers_topic_arn}",
        "Subject": "SentinelMesh alert issued",
        "Message.$": "$.issue.summary"
      },
      "ResultPath": null,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "Done" }],
      "Next": "Done"
    },
    "IssueFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${officers_topic_arn}",
        "Subject": "SentinelMesh: ALERT ISSUE FAILED - act manually",
        "Message.$": "States.Format('Issuing {} for zone {} failed. Issue it manually now.', $.tier, $.zone_id)"
      },
      "ResultPath": null,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "ReleaseAfterFailure" }],
      "Next": "ReleaseAfterFailure"
    },
    "EnqueueFailed": {
      "Comment": "The alert record and CAP file exist but nothing was queued for delivery: tell officers, then free the gate so the next trigger can retry.",
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${officers_topic_arn}",
        "Subject": "SentinelMesh: ALERT NOT DELIVERED - send manually",
        "Message.$": "States.Format('Alert {} ({} for zone {}) was issued but could not be queued for delivery. Send it manually now.', $.issue.alert_id, $.tier, $.zone_id)"
      },
      "ResultPath": null,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "ReleaseAfterFailure" }],
      "Next": "ReleaseAfterFailure"
    },
    "ReleaseAfterFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${zone_state_table}",
        "Key": { "zone_id": { "S.$": "$.zone_id" } },
        "UpdateExpression": "REMOVE alert_rank, alert_tier, alert_exec, alert_confirmed_at"
      },
      "ResultPath": null,
      "Next": "Failed"
    },
    "Failed": { "Type": "Fail", "Error": "IssueFailed" },
    "Done": { "Type": "Succeed" }
  }
}
