# Terraform working data and state (state lives in GitLab)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Variable files can hold secrets
*.tfvars
*.tfvars.json

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Lambda bundle built by Terraform
terraform/app/build/

# Edge programs' local state: buffered readings, fetched device certificates and keys
edge/state/

# Python local test/runtime bytecode
__pycache__/
*.pyc
